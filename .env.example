# Public URLs — на Droplet укажите IP или домен
WEB_URL=http://YOUR_DROPLET_IP:3000
NEXT_PUBLIC_API_URL=http://YOUR_DROPLET_IP:4000
CORS_ORIGIN=http://YOUR_DROPLET_IP:3000

# Ссылка на бота для кнопки «Telegramda ochish»
NEXT_PUBLIC_BOT_URL=https://t.me/YOUR_BOT_USERNAME

# API
API_PORT=4000
NODE_ENV=production
API_AUTO_SEED=1
ADMIN_TOKEN=change-me-admin-token

# Postgres (docker-compose поднимает сам)
POSTGRES_PASSWORD=underdog
DATABASE_URL=postgres://underdog:underdog@localhost:5432/underdog

# Telegram bot (профиль bot + лучше для helper)
BOT_TOKEN=
ADMIN_CHAT_ID=

# Helper
HELPER_AUTO_SEED=1
HELPER_BATCH_SIZE=8
HELPER_INTERVAL_MS=60000
HELPER_DELAY_MS=2000
HELPER_DISCOVER_EVERY=1
HELPER_QUERIES_PER_TICK=2
# Дополнительные username через запятую: durov,telegram
HELPER_SEED_USERNAMES=

# Полноценный автопоиск (MTProto / user account)
# 1) api_id + api_hash: https://my.telegram.org
# 2) session: npm run login -w @underdog/helper
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

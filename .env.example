# Public URLs — на Droplet укажите IP или домен
WEB_URL=http://YOUR_DROPLET_IP:3000
NEXT_PUBLIC_API_URL=http://YOUR_DROPLET_IP:4000
CORS_ORIGIN=http://YOUR_DROPLET_IP:3000

# API
API_PORT=4000
NODE_ENV=production

# Telegram bot (нужен для профиля bot)
BOT_TOKEN=

# Chat ID админа (число). Кнопка «Админ» и /admin только для этого чата.
# Узнать ID: напишите боту @userinfobot или любому echo-боту.
ADMIN_CHAT_ID=
